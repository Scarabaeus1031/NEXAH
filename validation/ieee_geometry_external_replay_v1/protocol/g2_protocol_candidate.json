  "comparators": [
    {
      "entity_scope": "all bus rows",
      "formula": "min(vm_pu)",
      "id": "v_min_pu",
      "independence": "direct input control; not independent validation",
      "source_field": "bus entity view variable vm_pu; corresponds to pandapower res_bus.vm_pu",
      "unit": "pu"
    },
    {
      "entity_scope": "all bus rows",
      "formula": "sqrt(sum((vm_pu - 1.0)^2) / bus_count)",
      "id": "v_dev_rms_pu",
      "independence": "derived from an existing V1 bus-voltage profile; not external evidence",
      "source_field": "bus entity view variable vm_pu; corresponds to pandapower res_bus.vm_pu",
      "unit": "pu"
    },
    {
      "entity_scope": "all line rows; transformer and other branch scopes excluded",
      "formula": "max(loading_percent)",
      "id": "l_max_percent",
      "independence": "direct input control; not independent validation",
      "source_field": "line entity view variable loading_percent; corresponds to pandapower res_line.loading_percent",
      "unit": "percent"
    },
    {
      "angle_handling": "solver reference retained; raw max minus min; no modulo, wrapping, or unwrapping",
      "entity_scope": "all bus rows",
      "formula": "max(va_degree) - min(va_degree)",
      "id": "angle_spread_degree",
      "independence": "direct input control; not independent validation",
      "source_field": "bus entity view variable va_degree; corresponds to pandapower res_bus.va_degree",
      "unit": "degree"
    }
  ],
  "derived_measures": {
    "absolute_adjacent_change": "abs(c_i - c_(i-1))",
    "centered_absolute_second_difference": "abs(c_(i+1) - 2*c_i + c_(i-1))",
    "cumulative_absolute_variation": "sum of absolute adjacent changes over the same contiguous converged segment",
    "signed_adjacent_change": "c_i - c_(i-1)"
  },
