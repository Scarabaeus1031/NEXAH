{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexah.local/schemas/nexah-compare/0.1/package-manifest.schema.json",
  "title": "NEXAH Compare v0.1 Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "package_id", "profile_id", "entries"],
  "properties": {
    "schema_id": {"const": "nexah.compare.package-manifest"},
    "schema_version": {"const": "0.1.0"},
    "package_id": {"type": "string", "pattern": "^PKG-[A-Z0-9][A-Z0-9._-]{3,124}$"},
    "profile_id": {"const": "NC01-ADVISORY-0.1"},
    "entries": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
          "role": {"enum": ["PACKAGE_DESCRIPTOR", "CASE_INPUT", "ANALYSIS_INPUT", "ALIGNMENT_INPUT", "EVIDENCE", "COMPARISON_OUTPUT", "MARKDOWN_OUTPUT"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
