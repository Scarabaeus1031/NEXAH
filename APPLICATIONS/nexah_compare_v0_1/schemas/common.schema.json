{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexah.local/schemas/nexah-compare/0.1/common.schema.json",
  "title": "NEXAH Compare v0.1 Common Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9][A-Z0-9._-]*)+$",
      "minLength": 5,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "minLength": 1,
      "maxLength": 512
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "basis", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "basis": {"enum": ["INSTANT", "DAY", "MONTH", "QUARTER", "YEAR", "CUSTOM"]},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actor_id", "confirmed_at", "confirmation_sha256"],
      "properties": {
        "status": {"const": "CONFIRMED"},
        "actor_id": {"$ref": "#/$defs/id"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "confirmation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "status", "kind", "path", "sha256", "locator"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["ADMITTED", "MISSING", "UNAVAILABLE"]},
        "kind": {"enum": ["DOCUMENT", "DATASET", "CALCULATION", "IMAGE", "OTHER"]},
        "path": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ADMITTED"}}},
          "then": {"properties": {"path": {"$ref": "#/$defs/relativePath"}, "sha256": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "unit_system", "time_basis"],
      "properties": {
        "value": {"$ref": "#/$defs/decimal"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "unit_system": {"enum": ["UCUM", "ISO_4217", "DIMENSIONLESS", "DECLARED_CUSTOM"]},
        "time_basis": {"enum": ["INSTANT", "DAY", "MONTH", "QUARTER", "YEAR", "CUSTOM", "NOT_APPLICABLE"]},
        "custom_definition": {"type": ["string", "null"], "maxLength": 512}
      }
    }
  }
}
