# =========================
# 🔥 NEXAH OUTPUT POLICY
# =========================

# ❌ Default: ignore ALL outputs everywhere
**/outputs/

# =========================
# ✅ CURATED VISUALS ONLY
# =========================

# --- ROOT DEMOS (important) ---
!outputs/
!outputs/demo/
!outputs/demo/*.png

# --- VISUAL SYSTEM (NEW CORE AREA) ---
!APPLICATIONS/visuals/
!APPLICATIONS/visuals/outputs/
!APPLICATIONS/visuals/outputs/*.png
!APPLICATIONS/visuals/outputs/*.gif

# --- CORE VISUALS USED IN README ---
!FIELD_LAYER/outputs/plots/
!FIELD_LAYER/outputs/plots/*.png

!FIELD_LAYER/FIELD_DECOMPOSITION/outputs/
!FIELD_LAYER/FIELD_DECOMPOSITION/outputs/**/*.png

!DISCOVERY_ENGINE/outputs/
!DISCOVERY_ENGINE/outputs/**/*.png

# --- IEEE KEY VISUALS ---
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/*.png

# =========================
# DATA (still ignored)
# =========================
**/*.csv
**/*.npy
**/*.npz

# =========================
# HEAVY MEDIA (default ignore)
# =========================
*.gif

# Allow only curated GIFs
!APPLICATIONS/visuals/outputs/*.gif

# =========================
# CACHE
# =========================
.cache/

# =========================
# ✅ VISUAL ROOT (IMPORTANT)
# =========================

!APPLICATIONS/visuals/
!APPLICATIONS/visuals/*.png
!APPLICATIONS/visuals/*.gif
!APPLICATIONS/visuals/*.md
