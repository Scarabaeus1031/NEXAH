# =========================
# SYSTEM (macOS)
# =========================
.DS_Store
.AppleDouble
.LSOverride

# =========================
# PYTHON
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.py,cover

# =========================
# VIRTUAL ENVIRONMENTS
# =========================
.venv/
venv/
env/
ENV/
clean_env/

# =========================
# PACKAGING
# =========================
*.egg-info/
dist/
build/

# =========================
# JUPYTER
# =========================
.ipynb_checkpoints/

# =========================
# TESTING
# =========================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# =========================
# TEMP / LOGS
# =========================
*.log
*.tmp
*.temp

# =========================
# EDITORS
# =========================
.vscode/
.idea/

# =========================
# 🔥 GLOBAL OUTPUT RULE
# =========================

# ignore ALL outputs by default
**/outputs/

# =========================
# 🔥 MEDIA POLICY
# =========================

# ignore heavy media globally
*.gif

# =========================
# ✅ CORE ALLOWLIST
# =========================

# --- ROOT DEMO ---
!outputs/
!outputs/demo/
!outputs/demo/*.png

# Reproducible Orientation MVP run artifacts are generated locally. Compact
# canonical metrics and failure cases are committed under validation/ instead.
/outputs/orientation_mvp/

# --- CORE VISUALS ---
!DISCOVERY_ENGINE/outputs/
!DISCOVERY_ENGINE/outputs/**/*.png

!FIELD_LAYER/outputs/
!FIELD_LAYER/outputs/**/*.png

# --- IEEE ---
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/*.png

# --- CONTROL ---
!ARCHITECTURE/CORE/control_layer/outputs/
!ARCHITECTURE/CORE/control_layer/outputs/**/*.png

# --- DEMONSTRATOR ---
!NEXAH_DEMONSTRATOR/visuals/
!NEXAH_DEMONSTRATOR/visuals/**/*.png
!NEXAH_DEMONSTRATOR/visuals/**/*.gif

# --- APPLICATION VISUALS ---
!APPLICATIONS/visuals/
!APPLICATIONS/visuals/**
!APPLICATIONS/visuals/**/*.png
!APPLICATIONS/visuals/**/*.gif

# =========================
# 🚀 FRACTAL SYSTEM (NEU)
# =========================

# allow traversal first (CRITICAL)
!RESEARCH/
!RESEARCH/APPLIED_CASES/
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/outputs/

# allow files inside
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/outputs/**
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/outputs/**/*.png
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/outputs/**/*.gif

# =========================
# DATA
# =========================
**/*.csv
**/*.npy
**/*.npz
**/data/

# =========================
# CACHE
# =========================
.cache/
# --- FRACTAL SYSTEM OUTPUTS ---
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/outputs/
!RESEARCH/APPLIED_CASES/FRACTAL_SYSTEMS/scripts/outputs/*.gif
