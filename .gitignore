# =========================
# ACCIDENTAL DUPLICATES
# =========================
* 2.*
* 3.*
* copy.*
* Kopie.*

# =========================
# 🔥 NEXAH ENGINE OUTPUTS
# =========================

# Ignore ALL outputs by default
**/outputs/*

# =========================
# FIELD_LAYER OUTPUTS (ALLOW)
# =========================

!FIELD_LAYER/outputs/
!FIELD_LAYER/outputs/plots/
!FIELD_LAYER/outputs/plots/*.png

# =========================
# DISCOVERY ENGINE (ALLOW SELECTED)
# =========================

!**/outputs/json/
!**/outputs/json/*.json

!**/outputs/visuals/
!**/outputs/visuals/**/*.png

# =========================
# VISUAL MASS OUTPUT (IGNORE)
# =========================
**/*.gif

# =========================
# DATA (Simulation Dumps)
# =========================
**/*.csv
**/*.npy
**/*.npz

# =========================
# CACHE / RENDER
# =========================
.cache/

# =========================
# ALLOW CURATED VISUALS ONLY
# =========================

# Lorenz curated visuals
!APPLICATIONS/dynamical_systems/lorenz/visuals/
!APPLICATIONS/dynamical_systems/lorenz/visuals/*.png

# Power system curated outputs
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_application/results/
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_application/results/*

# Specific analysis export
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/analysis_export/rift_extraction/

# Specific data allowed
!APPLICATIONS/power_systems/stability_field_dynamics/data/
!APPLICATIONS/power_systems/stability_field_dynamics/data/*.csv

# =========================
# END
# =========================
