*.pyc
*.pyo
*.pyd
*.py,cover

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
*.egg-info/
dist/
build/

# =========================
# JUPYTER / NOTEBOOKS
# =========================
.ipynb_checkpoints/

# =========================
# TESTING / COVERAGE
# =========================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# =========================
# LOGS / TEMP FILES
# =========================
*.log
*.tmp
*.temp

# =========================
# EDITOR / IDE
# =========================
.vscode/
.idea/

# =========================
