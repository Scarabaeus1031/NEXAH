# =========================
# 🔥 NEXAH OUTPUT POLICY
# =========================

# 1. IGNORE ALL OUTPUTS (default)
**/outputs/

# =========================
# ✅ ALLOW CURATED VISUALS (IMPORTANT)
# =========================

# --- DEMO (THIS IS YOUR CURRENT ISSUE FIX) ---
!outputs/
!outputs/demo/
!outputs/demo/*.png

# --- FIELD LAYER (plots used in README) ---
!FIELD_LAYER/outputs/
!FIELD_LAYER/outputs/plots/
!FIELD_LAYER/outputs/plots/*.png

# --- FIELD DECOMPOSITION VISUALS ---
!FIELD_LAYER/FIELD_DECOMPOSITION/outputs/
!FIELD_LAYER/FIELD_DECOMPOSITION/outputs/**/*.png

# --- DISCOVERY ENGINE VISUALS ---
!DISCOVERY_ENGINE/outputs/
!DISCOVERY_ENGINE/outputs/**/*.png

# --- APPLICATION VISUALS ---
!APPLICATIONS/**/outputs/
!APPLICATIONS/**/outputs/**/*.png

# =========================
# DATA (still ignored)
# =========================
**/*.csv
**/*.npy
**/*.npz

# =========================
# HEAVY MEDIA
# =========================
**/*.gif

# =========================
# CACHE
# =========================
.cache/
