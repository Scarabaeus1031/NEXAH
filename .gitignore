*.log
*.tmp
*.temp

# =========================
# EDITOR / IDE
# =========================
.vscode/
.idea/

# =========================
# 🔥 NEXAH OUTPUT POLICY
# =========================

# ❌ Default: ignore ALL outputs everywhere
**/outputs/

# =========================
# ✅ CURATED OUTPUTS (ALLOWLIST)
# =========================

# --- ROOT DEMO OUTPUTS ---
!outputs/
!outputs/demo/
!outputs/demo/*.png

# --- CORE VISUALS (README / DOCS) ---
!DISCOVERY_ENGINE/outputs/
!DISCOVERY_ENGINE/outputs/**/*.png

!FIELD_LAYER/outputs/
!FIELD_LAYER/outputs/**/*.png

!FIELD_LAYER/FIELD_DECOMPOSITION/outputs/
!FIELD_LAYER/FIELD_DECOMPOSITION/outputs/**/*.png

# --- IEEE KEY VISUALS ---
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/
!APPLICATIONS/power_systems/stability_field_dynamics/ieee_test_cases/outputs/*.png

# --- CONTROL LAYER VISUALS ---
!ARCHITECTURE/CORE/control_layer/outputs/
!ARCHITECTURE/CORE/control_layer/outputs/demo/
!ARCHITECTURE/CORE/control_layer/outputs/demo/*.png

# --- VISUAL SYSTEM (CURATED MEDIA) ---
!APPLICATIONS/visuals/
!APPLICATIONS/visuals/**/*.png
!APPLICATIONS/visuals/**/*.gif
!APPLICATIONS/visuals/**/*.md

# --- DEMONSTRATOR VISUALS ---
!NEXAH_DEMONSTRATOR/visuals/
!NEXAH_DEMONSTRATOR/visuals/**/*.gif
!NEXAH_DEMONSTRATOR/visuals/**/*.png

# =========================
# DATA (always ignored)
# =========================
**/*.csv
**/*.npy
**/*.npz

# =========================
# MEDIA POLICY
# =========================

# Ignore heavy media by default
*.gif

# Allow only curated GIFs
!APPLICATIONS/visuals/**/*.gif

# =========================
# CACHE
# =========================
.cache/

# --- HALVORSEN EXPERIMENTS (ALLOW NPY) ---
!APPLICATIONS/dynamical_systems/halvorsen/outputs/
!APPLICATIONS/dynamical_systems/halvorsen/outputs/*.npy

# ignore all raw data
**/*.npy
**/data/

# allow halvorsen outputs folder
!APPLICATIONS/dynamical_systems/halvorsen/outputs/

# but ignore raw outputs
APPLICATIONS/dynamical_systems/halvorsen/outputs/*.npy
APPLICATIONS/dynamical_systems/halvorsen/outputs/*.txt

# keep visuals
!APPLICATIONS/dynamical_systems/halvorsen/outputs/*.png
!APPLICATIONS/dynamical_systems/halvorsen/outputs/*.gif
!APPLICATIONS/dynamical_systems/halvorsen/outputs/*.mp4

# =========================
# VALIDATION LAYER (CURATED FIGURES)
# =========================

!APPLICATIONS/power_systems/VALIDATION_LAYER/figures/
!APPLICATIONS/power_systems/VALIDATION_LAYER/figures/*.png

# --- EXPERIMENTAL BUILDER LAB OUTPUTS ---
!BUILDER_LAB/EXPLORATION/experimental/outputs/
!BUILDER_LAB/EXPLORATION/experimental/outputs/**
!BUILDER_LAB/EXPLORATION/experimental/outputs/**/*.gif

!RESEARCH/NEXAH_DEVELOPMENT/gate_operator/output_results/
!RESEARCH/NEXAH_DEVELOPMENT/gate_operator/output_results/*.png

# =========================
# VALIDATION RESULTS (CURATED)
# =========================

!RESEARCH/validation/
!RESEARCH/validation/**/
!RESEARCH/validation/**/results/
!RESEARCH/validation/**/results/*.png
